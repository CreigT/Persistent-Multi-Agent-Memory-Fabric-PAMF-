{
  "name": "pamf-memory",
  "version": "0.1.0",
  "description": "Persistent Multi-Agent Memory Fabric MCP tools",
  "tools": [
    {
      "name": "memory_write",
      "description": "Persist a typed memory packet with evidence refs. SQL is source of truth.",
      "inputSchema": {
        "type": "object",
        "required": ["actor_agent", "memory_type", "summary", "confidence", "sensitivity"],
        "properties": {
          "actor_agent": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "memory_type": {"type": "string", "enum": ["working", "episodic", "semantic", "procedural", "preference", "risk"]},
          "summary": {"type": "string"},
          "facts": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "number"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "sensitivity": {"type": "string", "enum": ["public", "internal", "restricted", "secret"]},
          "purpose": {"type": "string"}
        }
      }
    },
    {
      "name": "memory_search",
      "description": "Retrieve top-k memory packets with ACL and purpose filters.",
      "inputSchema": {
        "type": "object",
        "required": ["query", "purpose"],
        "properties": {
          "query": {"type": "string"},
          "purpose": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "k": {"type": "integer", "default": 8}
        }
      }
    },
    {
      "name": "memory_get_entity_timeline",
      "description": "Ordered history for one business entity.",
      "inputSchema": {
        "type": "object",
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "limit": {"type": "integer", "default": 50}
        }
      }
    },
    {
      "name": "memory_supersede",
      "description": "Mark prior memory obsolete and attach replacement. Never silent rewrite.",
      "inputSchema": {
        "type": "object",
        "required": ["memory_id", "summary"],
        "properties": {
          "memory_id": {"type": "string"},
          "summary": {"type": "string"},
          "facts": {"type": "array"},
          "confidence": {"type": "number"}
        }
      }
    },
    {
      "name": "memory_forget",
      "description": "Policy-compliant deletion. Blocked on legal hold.",
      "inputSchema": {
        "type": "object",
        "required": ["memory_id", "reason", "policy_id"],
        "properties": {
          "memory_id": {"type": "string"},
          "reason": {"type": "string"},
          "policy_id": {"type": "string"},
          "approval_id": {"type": "string"}
        }
      }
    },
    {
      "name": "memory_explain_used",
      "description": "Given a decision_id, list memories that influenced it.",
      "inputSchema": {
        "type": "object",
        "required": ["decision_id"],
        "properties": {
          "decision_id": {"type": "string"}
        }
      }
    }
  ]
}
